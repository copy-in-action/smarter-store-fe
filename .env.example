# 사이트 기본 URL (프로토콜 포함)
# Vercel 배포 시: https://yourdomain.com
# 로컬 개발 시: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://ticket.devhong.cc

# API 서버 URL
NEXT_PUBLIC_API_SERVER=https://ticket-api.devhong.cc

# 개발 환경 API 서버 URL
NEXT_PUBLIC_API_DEV_SERVER=http://devhong.asuscomm.com:48080

# Vercel 배포 검증 토큰 (Cloudflare 보안 우회용)
# Vercel Project Settings → Deployment Protection → Vercel Authentication에서 확인
# Cloudflare에서 x-vercel-verify 헤더로 검증
VERCEL_DEPLOYMENT_VERIFY_TOKEN=your_vercel_verify_token_here

# Sentry 인증 토큰 (Sentry 사용 시 필요)
# https://sentry.io/ 에서 발급받을 수 있습니다
SENTRY_AUTH_TOKEN=your_sentry_auth_token_here
